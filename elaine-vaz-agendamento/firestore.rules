rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
             && request.auth.token.email in ['carol.bronze26@gmail.com'];
    }

    // Cada cliente só pode ler/editar o próprio perfil; admin lê todos
    match /usuarios/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Serviços são públicos para leitura (lista fixa, editada só pela equipe)
    match /servicos/{servicoId} {
      allow read: if true;
      allow write: if false; // gerenciado manualmente pelo Firebase Console
    }

    // Agendamentos: cliente cria/lê os seus; admin lê e atualiza todos (status)
    match /agendamentos/{agendamentoId} {
      allow create: if request.auth != null
                    && request.resource.data.usuarioId == request.auth.uid;
      allow read: if request.auth != null
                    && (resource.data.usuarioId == request.auth.uid || isAdmin());
      allow update: if isAdmin();
      allow delete: if false;
    }

    // Avaliações: qualquer pessoa com o link pode criar UMA (sem login,
    // pra não exigir que o cliente faça login de novo só pra avaliar).
    // Só é possível criar, nunca sobrescrever ou apagar — e só o admin lê.
    match /avaliacoes/{agendamentoId} {
      allow read: if isAdmin();
      allow create: if request.resource.data.nota is int
                    && request.resource.data.nota >= 1
                    && request.resource.data.nota <= 5
                    && !exists(/databases/$(database)/documents/avaliacoes/$(agendamentoId));
      allow update, delete: if false;
    }

    // Datas bloqueadas: o app de agendamento precisa ler (pra travar o
    // calendário), mas só o admin pode adicionar/remover.
    match /bloqueios/{dataKey} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
